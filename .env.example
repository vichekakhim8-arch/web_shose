# Frontend (Vite) — leave VITE_API_URL empty to use browser-local persistence.
# Set it to use the Node backend in /server (dev proxy forwards /api → :4000):
# VITE_API_URL=/api
# Or an absolute URL for a deployed backend:
# VITE_API_URL=https://api.example.com/api

# Backend (server/index.js)
PORT=4000
CORS_ORIGIN=*
ADMIN_EMAIL=admin@lumen.shop
ADMIN_PASSWORD=admin123
